{
  "name": "@marktext-migration/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript AI SDLC orchestrator, deterministic QA harness, policy gates, telemetry ledger, and @cursor/sdk integration for MarkText -> MarkText-GPUI migration",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node --import tsx src/cli.ts demo",
    "qa": "node --import tsx src/cli.ts qa",
    "dispatch": "node --import tsx src/cli.ts dispatch",
    "flags": "node --import tsx src/cli.ts flags"
  },
  "dependencies": {
    "@cursor/sdk": "latest",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
