{
  "environment": "dev",
  "description": "Development environment — migrated Rust components active by default with automatic fallback to legacy MarkText TS.",
  "components": {
    "word-count": {
      "mode": "migrated",
      "engine": "rust-core",
      "shadowSampleRate": 1.0,
      "fallbackOnError": true
    },
    "outline-toc": {
      "mode": "migrated",
      "engine": "rust-core",
      "shadowSampleRate": 1.0,
      "fallbackOnError": true
    },
    "markdown-blocks": {
      "mode": "legacy",
      "engine": "legacy-ts",
      "shadowSampleRate": 0.0,
      "fallbackOnError": true
    }
  }
}
