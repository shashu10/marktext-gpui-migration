# Cursor API Key for @cursor/sdk (Cloud Agent dispatch + SDK QA Verification Agent)
# Obtain from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_replace_me

# Optional: model override (defaults to composer-2.5)
CURSOR_MODEL=composer-2.5

# Optional: GitHub repo target for Cloud Agent dispatch (owner/repo)
MIGRATION_TARGET_REPO=shashu10/marktext-gpui-migration
